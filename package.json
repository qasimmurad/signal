    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.35",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/three": "0.187.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
